{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@openflocon/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/plugin"
  ]
}